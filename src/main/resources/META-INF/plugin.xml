<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="true">
    <id>com.quetwo.IntelliLucee</id>
    <name>Lucee CFML</name>
    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.lucee.org">Lucee Association Switzerland</vendor>
    <description><![CDATA[
        Plugin for the Lucee CFML runtime that helps developers build ColdFusion based applications.  Compatible with
        Lucee, Adobe ColdFusion and BoxLang based engines.

        Includes support for .CFM, .CFML, .CFC and .CFS based files.

        - Includes Syntax Highlighting, auto-complete, built-in documentation, component introspection
        - New project wizards and new file templates
        - Surround with and commenting helpers
        - Formatter / Linter

        Roadmap items:
        - Integrated debugger support
        - Better support for component class path introspection
        - Better support for ORM scaffolding
        ]]></description>

    <depends>com.intellij.modules.json</depends>
    <depends>JavaScript</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <depends>com.intellij.properties</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">

        <applicationService serviceImplementation="com.quetwo.intellilucee.settings.CFMLGlobalSettings"/>
        <applicationService serviceImplementation="com.quetwo.intellilucee.settings.CFMLFormatterApplicationSettings"/>
        <moduleService serviceImplementation="com.quetwo.intellilucee.settings.CFMLFormatterModuleSettings"/>

        <applicationConfigurable
                id="settings.intellilucee.global"
                displayName="Lucee CFML"
                parentId="tools"
                instance="com.quetwo.intellilucee.settings.CFMLGlobalSettingsConfigurable"/>

        <applicationConfigurable
                id="settings.intellilucee.cfml.formatter.application"
                displayName="CFML Formatter"
                parentId="tools"
                instance="com.quetwo.intellilucee.settings.CFMLFormatterApplicationConfigurable"/>

        <projectConfigurable
                id="settings.intellilucee.cfml.formatter.project.overrides"
                displayName="CFML Formatter Module Settings"
                parentId="tools"
                instance="com.quetwo.intellilucee.settings.CFMLFormatterProjectOverridesConfigurable"/>

        <fileType
                name="CFML"
                language="CFML"
                fieldName="INSTANCE"
                extensions="cfml;cfc;cfm;cfs"
                implementationClass="com.quetwo.intellilucee.file.CFMLFileType" />

        <!-- Editor syntax highlighting via the bundled TextMate engine. -->
        <textmate.bundleProvider implementation="com.quetwo.intellilucee.grammar.CFMLTextMateBundleProvider"/>
        <!--
            A custom file type otherwise shadows TextMate, so the TextMate highlighter
            is bound explicitly to the Carve file type / language (the BAML / fss pattern).
        -->
        <editorHighlighterProvider
                filetype="CFML"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
        <lang.syntaxHighlighterFactory
                language="CFML"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>

        <!-- Commenter to enable comments within the IDE -->
        <lang.commenter
                language="CFML"
                implementationClass="com.quetwo.intellilucee.editor.CFMLCommenter"/>

        <!-- Stub Lexer/Parser to allow for the TextMate bundle implementer to update the screen -->
        <lang.parserDefinition
                language="CFML"
                implementationClass="com.quetwo.intellilucee.parser.CFMLParserDefinition"/>

        <!-- Support for the 'Surrounds with...' options in the menus -->
        <lang.surroundDescriptor
                language="CFML"
                implementationClass="com.quetwo.intellilucee.editor.CFMLSurroundHelper"/>

        <!-- Support for folding functions -->
        <lang.foldingBuilder
                language="CFML"
                implementationClass="com.quetwo.intellilucee.editor.CFMLFoldingBuilder"/>

        <!-- Support for auto-closing pound signs, etc. inthe editor -->
        <typedHandler implementation="com.quetwo.intellilucee.editor.CFMLTypedHandler"/>

        <!-- LSP server implementation to add support for in-line docs and formatting commands -->
        <platform.lsp.integrationProvider implementation="com.quetwo.intellilucee.lsp.CFMLLspIntegrationProvider" />

        <!-- Support for the Debugger Configuration -->
        <configurationType implementation="com.quetwo.intellilucee.debugger.CFMLDapRemoteConfigurationType"/>
        <xdebugger.breakpointType implementation="com.quetwo.intellilucee.debugger.CFMLLineBreakpointType"/>

        <!-- Project Wizard support -->
        <directoryProjectGenerator implementation="com.quetwo.intellilucee.project.CFMLProjectGenerator"/>
        <newProjectWizard.generator implementation="com.quetwo.intellilucee.project.CFMLGeneratorNewProjectWizard"/>

        <!-- Files for new file templates -->
        <internalFileTemplate name="CFML Page (tag)"/>
        <internalFileTemplate name="CFML Page (script)"/>
        <internalFileTemplate name="CFML Class (tag)"/>
        <internalFileTemplate name="CFML Class (script)"/>

    </extensions>

    <actions>

        <action
                id="CFML.NewFile"
                class="com.quetwo.intellilucee.actions.CFMLFileCreateActions"
                text="CFML File"
                description="Create a ColdFusion file">
            <add-to-group group-id="NewGroup" anchor="last" />
        </action>

        <action
                id="CFML.OpenActiveApplicationFile"
                class="com.quetwo.intellilucee.actions.CFMLOpenActiveApplicationFileAction"
                text="Open Associated Application.cfc"
                description="Open this file's Application.cfc">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <action
                id="CFML.AddApplicationLifecycleStubs"
                class="com.quetwo.intellilucee.actions.CFMLAddApplicationStubsAction"
                text="Add Application Lifecycle Stubs"
                description="Add Application.cfc lifecycle function stubs">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="CFML.OpenActiveApplicationFile"/>
        </action>

        <action
                id="CFML.FormatDocument"
                class="com.quetwo.intellilucee.actions.CFMLFormatDocument"
                text="Format This Document"
                description="Format this document, according to the formatter rules">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="CFML.AddApplicationLifecycleStubs"/>
        </action>

    </actions>
</idea-plugin>
