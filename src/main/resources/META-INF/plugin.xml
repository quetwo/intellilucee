<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.quetwo.IntelliLucee</id>
    <name>IntelliLucee</name>
    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.lucee.org">Lucee Association Switzerland</vendor>
    <description><![CDATA[
        Plugin for Lucee CFML as well as Adobe ColdFusion.  Supports .cfm, .cfc., .cfs files
        ]]></description>

    <depends>com.intellij.modules.json</depends>
    <depends>JavaScript</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.properties</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">

        <applicationService serviceImplementation="com.quetwo.intellilucee.settings.CFMLFormatterApplicationSettings"/>
        <moduleService serviceImplementation="com.quetwo.intellilucee.settings.CFMLFormatterModuleSettings"/>

        <applicationConfigurable
                id="settings.intellilucee.cfml.formatter.application"
                displayName="CFML Formatter"
                parentId="tools"
                instance="com.quetwo.intellilucee.settings.CFMLFormatterApplicationConfigurable"/>

        <projectConfigurable
                id="settings.intellilucee.cfml.formatter.project.overrides"
                displayName="CFML Formatter Module Settings"
                parentId="tools"
                instance="com.quetwo.intellilucee.settings.CFMLFormatterProjectOverridesConfigurable"/>

        <fileType
                name="CFML"
                language="CFML"
                fieldName="INSTANCE"
                extensions="cfml;cfc;cfm;cfs"
                implementationClass="com.quetwo.intellilucee.file.CFMLFileType" />

        <!-- Editor syntax highlighting via the bundled TextMate engine. -->
        <textmate.bundleProvider implementation="com.quetwo.intellilucee.grammar.CFMLTextMateBundleProvider"/>
        <!--
            A custom file type otherwise shadows TextMate, so the TextMate highlighter
            is bound explicitly to the Carve file type / language (the BAML / fss pattern).
        -->
        <editorHighlighterProvider
                filetype="CFML"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
        <lang.syntaxHighlighterFactory
                language="CFML"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>

        <!-- Commenter to enable comments within the IDE -->
        <lang.commenter
                language="CFML"
                implementationClass="com.quetwo.intellilucee.editor.CFMLCommenter"/>

        <lang.parserDefinition
                language="CFML"
                implementationClass="com.quetwo.intellilucee.parser.CFMLParserDefinition"/>

        <lang.surroundDescriptor
                language="CFML"
                implementationClass="com.quetwo.intellilucee.editor.CFMLSurroundHelper"/>

        <lang.foldingBuilder
                language="CFML"
                implementationClass="com.quetwo.intellilucee.editor.CFMLFoldingBuilder"/>

        <platform.lsp.integrationProvider implementation="com.quetwo.intellilucee.lsp.CFMLLspIntegrationProvider" />

    </extensions>

    <actions>

        <action
                id="CFML.NewFile"
                class="com.quetwo.intellilucee.actions.CFMLFileCreateActions"
                text="CFML File"
                description="Create a ColdFusion file">
            <add-to-group group-id="NewGroup" anchor="last" />
        </action>

        <action
                id="CFML.OpenActiveApplicationFile"
                class="com.quetwo.intellilucee.actions.CFMLOpenActiveApplicationFileAction"
                text="Open Associated Application.cfc"
                description="Open this file's Application.cfc">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

    </actions>
</idea-plugin>
